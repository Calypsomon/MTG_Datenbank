{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "MTG Datenbank",
  "version": "0.1.0",
  "identifier": "com.perin.mtgdatenbank",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "title": "MTG_DB",
        "url": "pages/collection.html",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/backend/": "backend/",
      "resources/postgres/": "postgres/"
    }
  }
}